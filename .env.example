# Modrinth personal access token, created at https://modrinth.com/settings/pats
# Needs only read scopes (read projects / read versions).
ApiKey=mrp_your_token_here

# Modrinth profile to watch. Full link, bare username or user id all work.
# Separate several accounts with commas.
AccountLink=https://modrinth.com/user/your_username

# Discord webhook the updates are posted to.
DiscordWebhook=https://discord.com/api/webhooks/000000000000000000/xxxxxxxx

# Optional settings below.
# Minutes between checks when running with --watch.
PollMinutes=15
# Where the watcher remembers what it already posted.
StateFile=./state.json
# Contact address sent in the User-Agent, as Modrinth asks for.
ContactEmail=
